{
  "name": "cline-local-mcp-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "A local stdio MCP bridge for the Cline CLI.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "verify:workspace": "npm run build && node scripts/verify-workspace.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
